DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use "sqlite" for zero-setup local development or "postgresql" for PostgreSQL.
DB_ENGINE=postgresql
